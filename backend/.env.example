PORT=3001
NODE_ENV=development

# Leave unset (or containing "<cluster>"/"<username>") to fall back to an
# in-memory MongoDB instance for local development.
MONGODB_URI=

JWT_SECRET=replace-with-a-long-random-secret

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origin allowed to make credentialed requests, used in production
FRONTEND_URL=http://localhost:5173
